# ── Database ──
DB_URL=jdbc:postgresql://localhost:5432/firstpage
DB_USERNAME=postgres
DB_PASSWORD=your_password

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI ──
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key

# ── Firebase ──
FIREBASE_SERVICE_ACCOUNT_PATH=service-account.json

# ── Public URLs ──
# Where the SPA is served from. /s/{slug} redirects real visitors here after a
# chat app has read the link-preview tags, so every shared link depends on it.
FRONTEND_BASE_URL=http://localhost:3001
# Origins allowed to call the API. The frontend dev server must be listed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
