# ── Root .gitignore ──────────────────────────────────────────────────────

# Environment files (NEVER commit secrets)
.env
.env.local
.env.*.local

# Service account keys
**/service-account.json
**/serviceAccountKey.json

# IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr

# OS
.DS_Store
Thumbs.db

# Backend
backend/target/
backend/*.jar
backend/*.war

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.cache/

# Logs
*.log
